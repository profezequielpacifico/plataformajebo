# Copy to .env next to docker-compose.yml (or export these vars)
DB_NAME=jebo_2026
DB_USER=jebo
DB_PASSWORD=jebo_secret_change_me

JWT_SECRET=GENERALO_CON_npm_run_secret__NO_ESTE_VALOR_SIRVE
# Sin valor por defecto a proposito: si falta o es debil la app no arranca.
# Generar con: npm run secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Cookie de sesion con el flag Secure. Dejalo en false mientras la app se sirva
# por HTTP plano, que es como se publica hoy. Ponerlo en true sin HTTPS rompe el
# login de punta a punta y sin error visible: el navegador descarta la cookie y
# la primera llamada autenticada responde 401.
# Pasalo a true solo cuando haya un certificado TLS adelante.
COOKIE_SECURE=false

# Origin of the web container (browser)
CORS_ORIGIN=http://localhost:15173

BCRYPT_ROUNDS=12

# pgAdmin container
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
